#!/usr/bin/perl
use strict;
use warnings;

use Time::Piece;
use Data::Dump;

my $InputFile = "/tmp/files";
my $FindCommand = "find -L . -print > $InputFile";
my %FileList = ();
my $ConversionCommand = "/usr/bin/perl -p -e 's/\n/\r/g' < LatestFilesUnix.txt > LatestFiles.txt";
my $NumFiles = 0;
my $InputFileSorted = "/tmp/filessorted";
my $VERSION = "1.5.0";
my $filename = "$ENV{HOME}/.latestrc";
my $ServerName = "";
my $EDITOR = "nano";
my $SORTMODE = "name";
my @DateSort;
my $DEBUGMODE = "";
my $RepoDir = "";
my $DownloadNotice = "For best results download these files with FTP or Hotline
";
my @Entries;   # each item: [mtime, size, name]

my $HTML_Footers = <<"END_MESSAGE2";
</body>
</html>
END_MESSAGE2

# See if the EDITOR env var is set, use it if so
if ($ENV{'EDITOR'})
{
        $EDITOR = $ENV{'EDITOR'};
}

sub DebugPrint
{
	my $argument = shift;
	if ($DEBUGMODE eq "debug")
	{
		print $argument;
	}
}

print  "latestfiles file listing app by MarisaG v$VERSION\n";
print  "===================================================\n";

my $defaultfile = <<'END_TEMPLATE';
# Put Server name here:
Classic Macs OSX Cat Editions
# Put default mode here: "date" or "name"
date
# Download Notice
For best results download these files with FTP or Hotline
# Search Directory
/var/www/html/jdownloads
# Get more apps like this at https://marisa-apps.retro-os.live
END_TEMPLATE

if (! -f $filename)
{
	print "Settings file $filename not found, creating it...\n";
	open(FILEOUT, '>', $filename) or die $!;
	#        print FILEOUT "$defaultfile\n";
        print FILEOUT "$defaultfile";
	close(FILEOUT);
	system("$EDITOR $filename");
}

open(FILEIN, '<', $filename) or die $!;
my $LastLine = 0;
while(<FILEIN>)
{
	# print $_;
	if ((substr($_, 0, 1) eq "#") || ($_ eq ""))
	{
		# skip over comments
		next;
	}
	chop();
	if ($LastLine == 0)
	{
		$ServerName = $_;
		$LastLine++;
		DebugPrint("saw server name '$ServerName'\n");
		next;
	}
	elsif ($LastLine == 1)
	{
		$SORTMODE = $_;
		DebugPrint("saw sortmode '$SORTMODE'\n");
		if (($SORTMODE ne "date") && ($SORTMODE ne "name"))
		{
			$SORTMODE = "name";
		}
		$LastLine++;
	}
	elsif ($LastLine == 2)
	{
		$DownloadNotice = $_;
		$LastLine++;
		DebugPrint("saw download notice '$DownloadNotice'\n");
		next;
	}
	elsif ($LastLine == 3)
	{
		$RepoDir = $_;
		$LastLine++;
		DebugPrint("saw repodir '$RepoDir'\n");
		next;
	}
}
close(FILEIN);
my $UnixFile = "$RepoDir/LatestFilesUnix.txt";
my $OutputFile = "$RepoDir/LatestFiles.txt";
my $HTMLFile = "$RepoDir/LatestFiles.html";
my $HTML_Headers = <<"END_MESSAGE";
<html>
<header>
  <title>Files available for download</title>
  <meta charset="UTF-8">
  <meta name="description" content="List of files available for downloading">
  <meta name="keywords" content="file, download, number, contents, perl">
  <meta name="author" content="https://marisa-apps.retro-os.live">
</header>
<body>
<h1 align=center>Files Available For Download</h1>
<h2 align=center>$DownloadNotice</h2>
END_MESSAGE

my $num_args = $#ARGV + 1;
if ($num_args != 0)
{
        if ($ARGV[0] eq "prefs")
        {
                system("$EDITOR $filename");
                exit 0;
        }
        elsif (($ARGV[0] eq "help") || ($num_args > 1))
        {
                print "Usage: latestfiles [prefs|help|date|debug]\n";
                exit 0;
        }
        elsif ($ARGV[0] eq "date")
        {
                DebugPrint("SORTMODE = $SORTMODE\n");
                $SORTMODE = "date";
        }
        elsif ($ARGV[0] eq "name")
        {
                DebugPrint("SORTMODE = $SORTMODE\n");
                $SORTMODE = "name";
        }
        elsif ($ARGV[0] eq "debug")
        {
                DebugPrint("DEBUGTMODE = $DEBUGMODE\n");
                $DEBUGMODE = "debug";
        }
	else
        {
                print "Usage: latestfiles [prefs|help|date|debug]\n";
                exit 0;
        }
}
print  "Sorting by: $SORTMODE\n";

print "Scanning for files: ";
chdir($RepoDir);
system("$FindCommand");
system("sort --output=$InputFileSorted $InputFile");

open(my $fh, '<', $InputFileSorted)
  or die "Could not open file '$InputFileSorted' $!";

while (my $row = <$fh>)
{
	chomp $row;
	# print "row = '$row'\n";
	my $shortname = substr($row, 0, 3);
	# print "shortname = '$shortname'\n";
	if (($row eq ".")||($row eq "..")||($row eq "./Desktop Folder")||($shortname eq "./_"))
	{
		DebugPrint("Skipping $row\n");
		next;
	}
	elsif (-d $row)
	{
		DebugPrint("$row was a directory\n");
		next;
	}
	elsif ((index($row, "rsrc") != -1)||(index($row, 'index.html') != -1))
	{
		DebugPrint("submatch $row\n");
		next;
	}
        elsif (substr($row, -15) eq "LatestFiles.txt")
        {
                DebugPrint("$row was a blocked file\n");
                next;
        }
        elsif (substr($row, -9) eq ".htaccess")
        {
                DebugPrint("$row was a blocked file\n");
                next;
        }
        elsif (substr($row, -19) eq "LatestFilesUnix.txt")
        {
                DebugPrint("$row was a blocked file\n");
                next;
        }
        elsif (substr($row, -16) eq "LatestFiles.html")
        {
                DebugPrint("$row was a blocked file\n");
                next;
        }

	$row = substr($row, 2);
	# print "new $row\n";
	my ($dev,$ino,$mode,$nlink,$uid,$gid,$rdev,$size,
		$atime,$mtime,$ctime,$blksize,$blocks)
		= stat($row);
	if (! defined($mtime))
        {
		print "File is '$row'\n";
		exit 0;
        }
	# print "modify time: $mtime\n";
	$size = fmt2($size);
	if ($SORTMODE eq "date")
	{
		push @Entries, [$mtime, $size, $row];
	}
	else
	{
		$FileList{$row} = $mtime;
	}
	$NumFiles += 1;
}

print "Done\nProcessing Files: ";
foreach my $e (sort { $b->[0] <=> $a->[0] or $a->[2] cmp $b->[2] } @Entries)
{
	my $HumanDate = localtime($e->[0])->strftime('%F %T');
	push (@DateSort, [$HumanDate, $e->[1], $e->[2]]);
}

close ($fh);
sub fmt2 {
   my ($bytes) = @_;
   my @units = qw ( B KB MB GB TB );
   #divide by 1024 whilst above
   while ( $bytes > 1024 ) {
      shift(@units); #drop one of the units prefixes until one 'fits'.
      $bytes /= 1024;
   }
   return sprintf( '%.3g%s', $bytes, $units[0] );
}
sub fmtsize
{
        my $bytes = shift;

        my @variations = map { sprintf '%.3g%s', $bytes/1024 ** $_->[1], $_->[0] }
            [ " bytes" => 0 ],
            [ KB => 1 ],
            [ MB => 2 ],
            [ GB => 3 ];

        dd \@variations;

        return ( sort { length $a <=> length $b } @variations ) [0];
}

open($fh, '>', $UnixFile)
  or die "Could not create file '$UnixFile' $!";
open(my $htmlfh, '>', $HTMLFile)
  or die "Could not create file '$HTMLFile' $!";

print $htmlfh "$HTML_Headers";

my $HumanDate = localtime()->strftime('%F %T'); # adjust format to taste
print $fh "Last Scan:\t$HumanDate\n";
print $htmlfh "Last Scan:\t$HumanDate<br>\n";
print $fh "Files found:\t$NumFiles\n";
print $htmlfh "Files found:\t$NumFiles<br>\n";
print $fh "$DownloadNotice\n\n";
print $fh "$ServerName Latest Files v$VERSION\n";
print $htmlfh "$ServerName Latest Files v$VERSION<br>\n";
print $fh "===================================================\n";
print $fh "Upload Date\t\t\tSize\t\tFile Name\n";
print $htmlfh "<table border=2>\n";
print $htmlfh "<tr><th>Upload Date</th><th>Size</th><th>File Name</th></tr>\n";
print $fh "-------------\t\t\t---------\t----------\n";

if ($SORTMODE eq "date")
{
	foreach my $d (@DateSort)
	{
		my ($date, $size, $name) = @$d;
		print $fh "$date\t\t$size\t\t$name\n";
		print $htmlfh "<tr><td>$date</td><td>$size</td><td>$name</td></tr>\n";
	}
	print $htmlfh "</table>\n$HTML_Footers\n";
	close($fh);
	close($htmlfh);
	system($ConversionCommand);
	print "Done\n";
	exit 0;
}

open(my $filelist, '<', $InputFileSorted)
  or die "Could not open file '$InputFileSorted' $!";
while(my $CurFile = <$filelist>)
{
	chomp($CurFile);
	if (length($CurFile) <= 2)
	{
		next;
	}
	$CurFile = substr($CurFile, 2);
	# print "File is '$CurFile'\n";
	if (($CurFile eq ".")||($CurFile eq "..")||($CurFile eq "./Desktop Folder")||(substr($CurFile, 0, 1) eq "_"))
        {
                next;
        }
        elsif (substr($CurFile, -15) eq "LatestFiles.txt")
        {
                DebugPrint("$CurFile was a blocked file\n");
                next;
        }
        elsif (substr($CurFile, -16) eq "LatestFiles.html")
        {
                DebugPrint("$CurFile was a blocked file\n");
                next;
        }
        elsif (substr($CurFile, -19) eq "LatestFilesUnix.txt")
        {
                DebugPrint("$CurFile was a blocked file\n");
                next;
        }
        elsif (substr($CurFile, -9) eq ".htaccess")
        {
                DebugPrint("$CurFile was a blocked file\n");
                next;
        }
        elsif (-d $CurFile)
        {
                DebugPrint("$CurFile was a directory\n");
                next;
        }
        elsif (index($CurFile, "rsrc") != -1)
        {
                DebugPrint("Saw rsrc in '$CurFile'\n");
                next;
        }
	elsif (index($CurFile, 'index.html') != -1)
	{
		next;
	}
	elsif ($CurFile eq "")
	{
		next;
	}

	my ($dev,$ino,$mode,$nlink,$uid,$gid,$rdev,$size,
		$atime,$mtime,$ctime,$blksize,$blocks)
		= stat($CurFile);
	$mtime = localtime($mtime);
	$size = fmt2($size);
	print $fh "$mtime\t$size\t\t$CurFile\n";
	print $htmlfh "<tr><td>$mtime</td><td>$size</td><td>$CurFile</td></tr>\n";
}
print $htmlfh "</table>\n$HTML_Footers\n";
close($filelist);
close($htmlfh);
close($fh);
print "Done\n";

system($ConversionCommand);
exit 0;

